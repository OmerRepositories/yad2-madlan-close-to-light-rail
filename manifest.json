{
  "manifest_version": 3,
  "name": "קרבה לרכבת הקלה – יד2 ומדלן",
  "description": "מציג על מודעות נדל\"ן ביד2, מדלן ופייסבוק את המרחק לרכבת הקלה ואת המחיר למ\"ר.",
  "version": "1.11.17",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "הגדרות – קרבה לרכבת הקלה",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://overpass-api.de/*",
    "https://overpass.kumi.systems/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yad2.co.il/*",
        "https://www.madlan.co.il/*"
      ],
      "js": ["parse.js", "yad2.js", "madlan.js", "location.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["parse.js", "facebook-classifier.js", "facebook-page.js", "location.js", "fb.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
